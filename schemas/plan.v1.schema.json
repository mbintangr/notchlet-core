{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notchlet.dev/schemas/plan-v1.schema.json",
  "title": "Notchlet change plan v1",
  "type": "object",
  "required": ["intent", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["quick", "standard"] },
    "intent": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "capabilityName": { "type": "string", "minLength": 1 },
    "capabilityImpact": { "enum": ["none", "delta"] },
    "capabilityRationale": { "type": "string" },
    "capabilityDelta": { "type": "object" },
    "capabilitySeed": { "type": "boolean" },
    "evidencePolicy": { "enum": ["per-task", "end-of-change"] },
    "runCommand": { "type": "string", "minLength": 1 },
    "previewUrl": { "type": "string", "minLength": 1 },
    "readinessUrl": { "type": "string", "minLength": 1 },
    "environment": { "type": "object", "additionalProperties": { "type": "string" } },
    "setupCommand": { "type": "string", "minLength": 1 },
    "teardownCommand": { "type": "string", "minLength": 1 },
    "coveragePolicy": { "enum": ["advisory", "strict"] },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "readyTimeoutMs": { "type": "integer", "minimum": 0 },
    "readyIntervalMs": { "type": "integer", "minimum": 0 },
    "requirements": { "type": "array", "items": { "$ref": "./requirement.v1.schema.json" } },
    "acceptanceScenarios": { "type": "array", "items": { "$ref": "./acceptance-scenario.v1.schema.json" } },
    "designDecisions": { "type": "array", "items": { "$ref": "./design-decision.v1.schema.json" } },
    "checks": { "type": "array", "items": { "$ref": "./check.v1.schema.json" } },
    "tasks": { "type": "array", "items": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "dependencies": { "type": "array", "items": { "type": "string" } }, "requirementIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
    "artifactContents": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
